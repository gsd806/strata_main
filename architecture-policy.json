      "allowedDependencies": []
    },
    "src/email.js": {
      "role": "Resend integration and email security",
      "maxLines": 420,
      "allowedDependencies": []
    },
    "src/payments.js": {
      "role": "Paddle integration boundary",
      "maxLines": 480,
      "allowedDependencies": []
    },
    "src/plans.js": {
      "role": "Plan domain validation",
